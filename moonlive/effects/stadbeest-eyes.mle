// StadBeestEyes: a frog's eye. Golden iris, black slit pupil, and it looks around.

class StadBeestEyesEffect {
  byte hue = 30;
  byte pupil = 70;
  byte wander = 40;
  byte bpm = 7;
  byte audioReactive = 0;

  int dimensions() { return 2; }

  string tags() { return "💫🎶"; }

  void defineControls() {
    addControl("hue", hue, 0, 255); // iris color: 30 is amber, 60 green, 180 blue
    addControl("pupil", pupil, 10, 200); // how wide the slit opens
    addControl("wander", wander, 0, 100); // how far the eye looks around
    addControl("bpm", bpm, 1, 60); // how restless the gaze is
    addControl("audioReactive", audioReactive, 0, 1); // the pupil dilates on sound
  }

  void tick() {
    int gazeX = div((beatsin(bpm, t, 255) - 128) * wander, 400);
    int gazeY = div((beatsin(bpm + 3, t, 255) - 128) * wander, 400);

    int open = pupil;
    if (audioReactive == 1) { open = pupil + div(audioLevel() * 90, 256); }

    int cx = div(width, 2) + gazeX;
    int cy = div(height, 2) + gazeY;

    for (int y = 0; y < height; y = y + 1) {
      for (int x = 0; x < width; x = x + 1) {
        int dx = x - cx;
        int dy = y - cy;
        int r = polarR(dx, dy);

        int slit = polarR(dx, dy * 5);

        if (slit < div(open, 16)) {
          setRGB(y * width + x, 0, 0, 0);           // the pupil: genuinely black
        } else {
          int a = polarA(dx, dy);
          int fibre = div(sin(a * 12) + 32768, 512);
          int bright = 255 - div(r * 9, 16) + div(fibre, 3);
          if (bright < 30) { bright = 30; }
          if (bright > 255) { bright = 255; }
          setPaletteColor(x, y, hue + div(r, 3), bright);
        }
      }
    }
  }
}
